// OpenClaw 2026.7.1 config patch: desk + artist + reviewer. setup.sh fills the __PLACEHOLDERS__.
// Apply: openclaw config patch --file openclaw.patch.generated.json5 [--dry-run]
{
  // Local model: vLLM on the GB10 (started with `bash ~/kit/restore.sh vllm`)
  models: {
    providers: {
      vllm: {
        baseUrl: "http://127.0.0.1:8000/v1",
        apiKey: "${VLLM_API_KEY}",
        api: "openai-completions",
        timeoutSeconds: 300,
        models: [
          {
            id: "nvidia/Qwen3.6-35B-A3B-NVFP4",
            name: "Qwen3.6 35B NVFP4 (GB10 local)",
            reasoning: true,
            input: ["text", "image"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 131072,
            maxTokens: 8192,
          },
        ],
      },
    },
  },

  // Local image generation through ComfyUI (bundled comfy provider in 7.1)
  plugins: {
    entries: {
      comfy: {
        config: {
          mode: "local",
          baseUrl: "http://127.0.0.1:8188",
          image: { workflowPath: "/home/dell/kit/workflows/sdxl_api.json", promptNodeId: "6", outputNodeId: "9" },
        },
      },
    },
  },

  agents: {
    defaults: {
      model: { primary: "vllm/nvidia/Qwen3.6-35B-A3B-NVFP4" },
      mediaModels: { image: { primary: "comfy/workflow" } },
      subagents: { maxSpawnDepth: 1, maxConcurrent: 4, maxChildrenPerAgent: 5, runTimeoutSeconds: 900, requireAgentId: true },
    },
    list: [
      { id: "main", workspace: "/home/dell/.openclaw/workspace" },
      {
        id: "desk",
        workspace: "/home/dell/.openclaw/workspace-desk",
        skills: ["tickets"],
        subagents: { allowAgents: ["artist", "reviewer"] },
        tools: { profile: "minimal", alsoAllow: ["read", "exec", "view_image", "message", "agents_list", "sessions_spawn", "sessions_yield", "subagents"] },
      },
      {
        id: "artist",
        workspace: "/home/dell/.openclaw/workspace-artist",
        skills: ["tickets"],
        tools: { profile: "minimal", alsoAllow: ["read", "exec", "view_image", "image_generate"], deny: ["sessions_spawn", "sessions_send", "sessions_yield", "subagents"] },
      },
      {
        id: "reviewer",
        workspace: "/home/dell/.openclaw/workspace-reviewer",
        skills: ["tickets"],
        tools: { profile: "minimal", alsoAllow: ["read", "exec", "view_image"], deny: ["sessions_spawn", "sessions_send", "sessions_yield", "subagents", "image_generate"] },
      },
    ],
  },

  // Everything in the Discord server goes to the desk (it's the default agent).
  channels: {
    discord: {
      enabled: true,
      token: { source: "env", provider: "default", id: "DISCORD_BOT_TOKEN" },
      groupPolicy: "allowlist",
      guilds: { "1556001402587971715": { requireMention: false } },
    },
  },
}
